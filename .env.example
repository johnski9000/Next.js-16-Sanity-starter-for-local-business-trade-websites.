# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — Template
#
# Copy this file to `.env` at the repo root and fill in the values for your client:
#   cp .env.example .env
# Do NOT commit `.env` — it is gitignored. This file is a real dotenv template;
# every non-comment line is KEY=VALUE so a verbatim copy loads correctly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity (required) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SANITY_STUDIO_URL=           # e.g. https://my-project.sanity.studio
# SANITY_API_READ_TOKEN must be a VIEWER-scoped (read-only) token: next-sanity can
# ship it to the browser during a Draft Mode preview session. Never use an
# Editor/Deploy-scoped token here. Used by the frontend live preview + SEO toolkit.
SANITY_API_READ_TOKEN=
# Write token. REQUIRED by scripts/onboard-client.mjs (read from THIS root .env).
# The studio seed scripts (pnpm -F studio seed:all) use your `sanity login` session
# by default — they read studio/.env, not this file, so for token-based (CI) seeding
# put the token in studio/.env instead. DO NOT deploy with this set.
SANITY_WRITE_TOKEN=

# ── Site (required) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                     # e.g. https://www.example.com
NEXT_PUBLIC_BASE_URL=                     # same as SITE_URL — used by some scripts
GSC_SITE_URL=                             # e.g. https://www.example.com/ (trailing slash for the GSC API)

# ── Google APIs — OAuth (for GSC + GA4 + optional GBP) ───────────────────────
# AGENCY-WIDE: reuse the SAME client id / secret / refresh token across every client
# site — just grant the agency Google account access to each client's GSC/GA4/GBP.
# One OAuth client + refresh token covers all three APIs; generate via OAuth Playground,
# granting ALL scopes in a single exchange (you can't add scopes to a token later):
#   webmasters.readonly (GSC), analytics.readonly + analytics.edit (GA4), business.manage (GBP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Google Analytics 4 (required) ────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=                        # e.g. G-XXXXXXXXXX (MEASUREMENT ID — for the gtag)
GA4_PROPERTY_ID=                          # e.g. 123456789 (NUMERIC Property ID — NOT the G-XXX id)

# ── Google Business Profile (OPTIONAL — local-pack metrics) ──────────────────
# Leave BOTH blank to skip GBP: the Monday runner shows "· skipped (not configured)"
# and the rest of the weekly cycle runs normally.
# To enable: the Business Profile *Performance* API quota defaults to ZERO, so submit the
# allowlist form ONCE for your agency Cloud project (covers all clients; 7-10 business days)
# at https://support.google.com/business/contact/api_default — then add the per-client IDs.
GBP_ACCOUNT_ID=                           # optional — e.g. accounts/123456789
GBP_LOCATION_ID=                          # optional — e.g. locations/123456789

# ── Ahrefs (optional — competitor/backlink GAP, run in the 4-weekly cycle ONLY) ─
# Reserve Ahrefs for the monthly competitor gap (analyse-ahrefs.mjs). Do NOT run the
# gap/backlink crawlers at onboarding — they paginate thousands of rows and burn credits.
AHREF_API_KEY=                            # AHREFS_API_KEY also accepted

# ── DataForSEO (optional — cheap keyword VOLUME + SERP research at onboarding) ──
# Pay-as-you-go. scripts/dataforseo-volume.mjs adds search volume + keyword difficulty
# (a winnability priority); scripts/dataforseo-serp.mjs adds the real SERP "People Also
# Ask" + auto-discovers local competitors. Same creds for both. No creds = clean no-op.
DATAFORSEO_LOGIN=                         # DataForSEO API login (the account email)
DATAFORSEO_PASSWORD=                      # DataForSEO API password
DATAFORSEO_LOCATION_CODE=2826             # 2826 = United Kingdom
DATAFORSEO_LANGUAGE_CODE=en

# ── Google PageSpeed Insights (optional) ─────────────────────────────────────
GOOGLE_PAGESPEED_API_KEY=                 # API key from Cloud Console (not OAuth)

# ── Email — Contact / Quote forms (Gmail via App Password) ───────────────────
# The Gmail below AUTHENTICATES + SENDS every enquiry; it is DELIVERED to the
# business — the tenant's own mail.leadEmail first, then NODEMAILER_TO, then (last
# resort) the NODEMAILER_EMAIL inbox itself. Reply-to = the customer. Use a 16-char
# App Password (account needs 2-Step Verification), NOT the normal password.
NODEMAILER_EMAIL=                         # the agency Gmail address that SENDS the mail
NODEMAILER_PASSWORD=                      # 16-char Google App Password
NODEMAILER_TO=                            # OPTIONAL global recipient — only used when a tenant has no mail.leadEmail

# ── Cloudflare Turnstile — OPTIONAL CAPTCHA on the contact form ──────────────
# The form works without these (built-in honeypot + per-IP rate limit). Set BOTH
# keys (https://dash.cloudflare.com → Turnstile) only if you want a CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TWITTER_HANDLE=               # e.g. @yourbusiness — for the twitter:site meta tag

# ─────────────────────────────────────────────────────────────────────────────
# Quick sanity check after filling in .env:
#   cd studio && npx sanity documents query '*[_type == "settings"][0].branding.siteTitle'
#   node frontend/seo/gsc-query.mjs --sites
#   node -e "import('./frontend/seo/_sanity-seo-data.mjs').then(m => m.getSettings().then(console.log))"
# ─────────────────────────────────────────────────────────────────────────────
