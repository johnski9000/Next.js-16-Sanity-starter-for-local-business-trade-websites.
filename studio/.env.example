SANITY_STUDIO_PROJECT_ID="<paste your project ID here>" # Required - The ID of your Sanity project
SANITY_STUDIO_DATASET="production" # Required - The dataset of your Sanity project
SANITY_STUDIO_PREVIEW_URL="" #Optional - defaults to http://localhost:3000
SANITY_STUDIO_STUDIO_HOST="" #Optional

# The seed scripts (pnpm -F studio seed:all) authenticate as your logged-in Sanity
# user by default — run `sanity login` once and you do NOT need a token here.
# For CI / non-interactive seeding, set a write token instead (takes precedence over
# the login session). The Sanity CLI reads THIS file (studio/), not the repo-root .env.
SANITY_WRITE_TOKEN="" # Optional - only for non-interactive (CI) seeding