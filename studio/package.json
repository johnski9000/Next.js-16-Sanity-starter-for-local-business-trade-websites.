{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "predev": "npm run sanity:typegen",
    "dev": "sanity dev",
    "seed": "sanity exec scripts/seed.example.ts --with-user-token",
    "data": "sanity exec scripts/getCurrentData.ts --with-user-token",
    "seed:dev": "sanity exec scripts/seed-dev.ts --with-user-token",
    "seed:site": "sanity exec scripts/seed-site.ts --with-user-token",
    "seed:seo": "sanity exec scripts/seed-seo-defaults.ts --with-user-token",
    "seed:all": "npm run seed:dev && npm run seed:site && npm run seed:seo",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --path ../sanity.schema.json && sanity typegen generate",
    "start": "sanity start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "^5.0.2",
    "@sanity/icons": "^3.7.4",
    "@sanity/vision": "^5.28.0",
    "date-fns": "^4.1.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rxjs": "^7.8.2",
    "sanity": "^5.28.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.2.7",
    "typescript": "^5.9.3"
  }
}
