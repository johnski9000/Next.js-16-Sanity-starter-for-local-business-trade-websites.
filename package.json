{
  "name": "groundwork",
  "private": true,
  "description": "An SEO-first Next.js 16 + Sanity starter for local-business & trade websites — Schema.org JSON-LD, CMS-driven page builder, lead capture, plus a 4-week SEO engine (GSC/GA4/Ahrefs/DataForSEO).",
  "keywords": [
    "nextjs",
    "sanity",
    "typescript",
    "tailwindcss",
    "seo",
    "json-ld",
    "schema-org",
    "cms",
    "starter",
    "local-business"
  ],
  "workspaces": [
    "studio",
    "frontend"
  ],
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "run-p --print-label dev:*",
    "dev:next": "pnpm -F frontend dev",
    "dev:studio": "pnpm -F studio dev",
    "seed:all": "pnpm -F studio seed:all",
    "seed:dev": "pnpm -F studio seed:dev",
    "seed:site": "pnpm -F studio seed:site",
    "seed:seo": "pnpm -F studio seed:seo",
    "onboard": "node scripts/onboard-client.mjs",
    "format": "prettier --cache --write .",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces"
  },
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@sanity/prettier-config": "^2.0.2",
    "npm-run-all2": "^5.0.2",
    "postcss": "^8.5.6",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.7.3"
  },
  "dependencies": {
    "@sanity/table": "^2.0.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0"
  }
}