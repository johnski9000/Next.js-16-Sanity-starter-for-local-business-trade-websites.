NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

# ---------------------------------------------------------------------------
# Contact form email — Gmail via App Password
# ---------------------------------------------------------------------------
#
# 1. Sign in to https://myaccount.google.com using the business Gmail.
# 2. Enable 2-Step Verification (Security → "2-Step Verification") — App
#    passwords require 2FA on the account.
# 3. Open https://myaccount.google.com/apppasswords and create a "Mail" App
#    Password. Google shows a 16-character password ONCE — paste it into
#    NODEMAILER_PASSWORD (spaces optional; nodemailer accepts both).
# 4. NEVER commit real values — keep them in `.env` (gitignored) and in
#    Vercel's environment-variable settings for production.
#
# This Gmail AUTHENTICATES + SENDS every enquiry; the lead is DELIVERED to
# NODEMAILER_TO (else, as a last resort, this inbox itself). Reply-to is the customer.

NODEMAILER_EMAIL="you@gmail.com"                     # the Gmail address that SENDS
NODEMAILER_PASSWORD="<16-char Google app password>"  # NOT the normal account password
NODEMAILER_TO=""                                     # where enquiries are delivered (defaults to the sending inbox)

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — OPTIONAL CAPTCHA on the contact form
# ---------------------------------------------------------------------------
# The form works WITHOUT these (built-in honeypot + per-IP rate limit handle
# spam). To add a CAPTCHA challenge, set BOTH keys from
# https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Site URL — used for absolute URLs in metadata, sitemap, OG images
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ---------------------------------------------------------------------------
# Lead persistence — save enquiries as `lead` docs in your Sanity project
# ---------------------------------------------------------------------------
# Optional but recommended: a WRITE token lets the contact route ALSO store each
# enquiry in Sanity (a durable backup of the email). Without it, leads deliver by
# email only. Create at sanity.io/manage → API → Tokens (Editor).
SANITY_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Design + analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DESIGN=""                  # palette preset: navy|slate|forest|crimson|graphite (default: navy)
NEXT_PUBLIC_BRAND_COLOR=""             # optional hex (#RRGGBB) override for the brand colour only
NEXT_PUBLIC_GA_ID=""                   # GA4 measurement id (G-XXXX) for the on-site analytics tag

# --- Instant publishes (Sanity webhook -> /api/revalidate) — optional ---
SANITY_REVALIDATE_SECRET=""

# --- Error tracking (Sentry) — optional ---
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG="" ; SENTRY_PROJECT="" ; SENTRY_AUTH_TOKEN=""   # optional — source-map upload

# --- Cross-instance rate limiting (Upstash Redis REST) — optional ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
